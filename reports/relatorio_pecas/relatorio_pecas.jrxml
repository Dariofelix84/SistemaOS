<?xml version="1.0" encoding="UTF-8"?>
<!-- Created for SistemaOS - Relatório de Peças em Estoque com Valor Unitário e Valor Total -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="relatorio_pecas" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="e6d1025c-a523-48aa-9dd3-027237329675">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter"/>
	<parameter name="nome_filtro" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select  
id_peca, nome_peca, qtd_estoque, valor_peca, (qtd_estoque * valor_peca) as total_item
from tbpecas
WHERE ($P{nome_filtro} IS NULL OR lower(nome_peca) LIKE lower(concat('%', $P{nome_filtro}, '%')))
ORDER BY nome_peca ASC]]>
	</queryString>
	<field name="id_peca" class="java.lang.Integer">
		<property name="com.jaspersoft.studio.field.label" value="id_peca"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="tbpecas"/>
	</field>
	<field name="nome_peca" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="nome_peca"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="tbpecas"/>
	</field>
	<field name="qtd_estoque" class="java.lang.Integer">
		<property name="com.jaspersoft.studio.field.label" value="qtd_estoque"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="tbpecas"/>
	</field>
	<field name="valor_peca" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="valor_peca"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="tbpecas"/>
	</field>
	<field name="total_item" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="total_item"/>
	</field>
	<variable name="total_qtd_sum" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{qtd_estoque}]]></variableExpression>
	</variable>
	<variable name="total_valor_sum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{total_item}]]></variableExpression>
	</variable>
