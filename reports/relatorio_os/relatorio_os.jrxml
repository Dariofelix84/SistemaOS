	<parameter name="os" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[SELECT tbos.os, tbos.data_os, tbos.tipo, tbos.situacao, tbos.equipamento, tbos.defeito, tbos.servico, tbos.tecnico, tbos.valor,
       tbclientes.nome_cliente, tbclientes.fone_cliente, tbclientes.email_cliente
FROM tbos
INNER JOIN tbclientes ON tbos.id_cliente = tbclientes.id_cliente
WHERE tbos.os = $P{os}]]>
	</queryString>
